function setup() {
  createCanvas(600, 600);
}
function draw() {
  
  // color para el fondo y funcion para quitar el relleno de las figuras
  noStroke();
  fill(245, 205, 70);
  rect(0, 0, 600, 420);

  //rectangulo para simular mi mesa
  fill(210, 160, 50); 
  rect(0, 420, 600, 180);

  //linea para simular la division de la mesa de la pared
  stroke(140, 90, 30);
  strokeWeight(4);
  line(0, 420, 600, 420); 

  // rectangulos para simular el jarron 
  noStroke();
  fill(235, 195, 80); 
  rect(225, 300, 150, 70);

  fill(200, 145, 45); 
  rect(225, 370, 150, 90);

  //linea para dividir los colores del jarron 
  stroke(140, 90, 30);
  strokeWeight(3);
  line(225, 370, 375, 370);

  // lineas para simular los tallos de los girasoles
  stroke(90, 125, 45);
  strokeWeight(10);
  line(300, 300, 300, 180); 
  line(300, 300, 210, 210); 
  line(300, 300, 390, 200);
  

  // triangulos para los petalos
  noStroke();
  fill(240, 170, 20);

  // petalos de la flor de en medio 
  triangle(300, 180, 280, 110, 320, 110);
  triangle(300, 180, 280, 250, 320, 250); 
  triangle(300, 180, 230, 160, 230, 200);
  triangle(300, 180, 370, 160, 370, 200); 

  // petalos de la flor izquierda del centro
  triangle(210, 210, 190, 150, 230, 150); 
  triangle(210, 210, 190, 270, 230, 270); 
  triangle(210, 210, 150, 190, 150, 230);
  triangle(210, 210, 270, 190, 270, 230);

  // petalos de la flor derecha 
  triangle(390, 200, 370, 140, 410, 140);
  triangle(390, 200, 370, 260, 410, 260); 
  triangle(390, 200, 330, 180, 330, 220); 
  triangle(390, 200, 450, 180, 450, 220); 

  // petlos de la flor de abajo izquierda 
  triangle(240, 260, 225, 210, 255, 210); 
  triangle(240, 260, 225, 310, 255, 310); 
  triangle(240, 260, 190, 245, 190, 275); 
  triangle(240, 260, 290, 245, 290, 275); 

  // petalos de la flor de abajo a la derecha 
  triangle(360, 270, 345, 220, 375, 220); 
  triangle(360, 270, 345, 320, 375, 320); 
  triangle(360, 270, 310, 255, 310, 285); 
  triangle(360, 270, 410, 255, 410, 285); 

  // circulos cafes de los girasoles
  fill(100, 60, 20);
  ellipse(300, 180, 75, 75); 
  ellipse(210, 210, 65, 65); 
  ellipse(390, 200, 65, 65); 
  ellipse(240, 260, 55, 55); 
  ellipse(360, 270, 55, 55); 

  //centros claros de los circulos cafes
  fill(160, 100, 30);
  ellipse(300, 180, 45, 45);
  ellipse(210, 210, 35, 35);
  ellipse(390, 200, 35, 35);
  ellipse(240, 260, 35, 35);
  ellipse(360, 270, 35, 35);

}

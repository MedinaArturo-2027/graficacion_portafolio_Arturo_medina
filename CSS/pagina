<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portafolio | Graficación</title>
    
    <style>
        :root {
            --bg-body: #0b0f19;
            --bg-card: rgba(23, 32, 54, 0.7);
            --border-card: rgba(255, 255, 255, 0.08);
            --text-primary: #ffffff;
            --text-secondary: #94a3b8;
            --accent-cyan: #00f2fe;
            --accent-purple: #4facfe;
            --btn-gradient: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
            --shadow-glow: 0 8px 32px 0 rgba(0, 242, 254, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-body);
            background-image: 
                radial-gradient(at 0% 0%, rgba(0, 242, 254, 0.12) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(79, 172, 254, 0.12) 0px, transparent 50%);
            background-attachment: fixed;
            color: var(--text-primary);
            min-height: 100vh;
            padding: 2rem 1rem;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        /* BANNER PRINCIPAL / HEADER */
        header {
            background: var(--bg-card);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border-card);
            border-radius: 20px;
            padding: 2.5rem 2rem;
            text-align: center;
            margin-bottom: 3rem;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
            position: relative;
            overflow: hidden;
        }

        header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--btn-gradient);
        }

        header h1 {
            font-size: 2.4rem;
            font-weight: 800;
            background: var(--btn-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1rem;
            letter-spacing: -0.5px;
        }

        .info-alumno {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            flex-wrap: wrap;
            color: var(--text-secondary);
            font-size: 1rem;
        }

        .info-alumno span {
            background: rgba(255, 255, 255, 0.05);
            padding: 0.4rem 1rem;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .info-alumno strong {
            color: var(--accent-cyan);
        }

        /* SECCIONES DE UNIDAD */
        .unidad-seccion {
            margin-bottom: 3rem;
        }

        .unidad-titulo {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .unidad-titulo::before {
            content: '';
            width: 12px;
            height: 12px;
            background: var(--accent-cyan);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent-cyan);
        }

        /* GRID DE TARJETAS */
        .grid-actividades {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .tarjeta-actividad {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--border-card);
            border-radius: 16px;
            padding: 1.8rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .tarjeta-actividad:hover {
            transform: translateY(-7px);
            border-color: rgba(0, 242, 254, 0.4);
            box-shadow: var(--shadow-glow);
        }

        .tarjeta-actividad h3 {
            font-size: 1.25rem;
            color: var(--text-primary);
            margin-bottom: 0.8rem;
        }

        .tarjeta-actividad p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.5;
            margin-bottom: 1.5rem;
            flex-grow: 1;
        }

        /* BOTONES DE ENLACE */
        .btn-enlace {
            display: block;
            text-align: center;
            background: var(--btn-gradient);
            color: #0b0f19;
            font-weight: 700;
            text-decoration: none;
            padding: 0.8rem 1.2rem;
            border-radius: 10px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 15px rgba(0, 242, 254, 0.2);
        }

        .btn-enlace:hover {
            opacity: 0.9;
            transform: scale(1.02);
            box-shadow: 0 6px 20px rgba(0, 242, 254, 0.4);
        }

        @media (max-width: 600px) {
            header h1 { font-size: 1.8rem; }
            .info-alumno { flex-direction: column; gap: 0.5rem; }
        }
    </style>
</head>
<body>

    <div class="container">
        
        <!-- HEADER PRINCIPAL -->
        <header>
            <h1>Portafolio de Prácticas - Graficación</h1>
            <div class="info-alumno">
                <span><strong>Alumno:</strong> Arturo Uriel Medina Tamayo</span>
                <span><strong>Matrícula:</strong> 251k0045</span>
                <span>ISC - 3er Semestre</span>
            </div>
        </header>

        <main>
            <!-- UNIDAD 1 -->
            <section class="unidad-seccion">
                <h2 class="unidad-titulo">Unidad 1: Introducción a los ambientes de graficación</h2>
                
                <div class="grid-actividades">
                    
                    <div class="tarjeta-actividad">
                        <div>
                            <h3>Actividad 1.1: Primitivas</h3>
                            <p>Manejo del sistema de coordenadas en Canvas, trazado de formas básicas, control de posiciones (x, y), dimensiones y propiedades de color.</p>
                        </div>
                        <a href="https://editor.p5js.org/MEDINA_ARTURO0610/full/COl0hv5a_" target="_blank" class="btn-enlace">Ver Proyecto 2D</a>
                    </div>

                    <div class="tarjeta-actividad">
                        <div>
                            <h3>Actividad 1.2: Colores</h3>
                            <p>Aplicación de formatos y modelos de color (RGB, HEX, HSB) para el renderizado e interacción gráfica en el lienzo.</p>
                        </div>
                        <a href="https://editor.p5js.org/MEDINA_ARTURO0610/full/CgcCavZ29" target="_blank" class="btn-enlace">Ver Proyecto</a>
                    </div>

                    <div class="tarjeta-actividad">
                        <div>
                            <h3>Actividad 1.3: Arte Digital</h3>
                            <p>Exploración de conceptos de diseño visual y creatividad algorítmica aplicada al desarrollo de aplicaciones gráficas.</p>
                        </div>
                        <a href="https://editor.p5js.org/MEDINA_ARTURO0610/full/Hb_IpXM-K" target="_blank" class="btn-enlace">Ver Proyecto</a>
                    </div>

                </div>
            </section>

            <!-- UNIDAD 2 -->
            <section class="unidad-seccion">
                <h2 class="unidad-titulo">Unidad 2: Graficación 2D</h2>
                
                <div class="grid-actividades">
                    
                    <div class="tarjeta-actividad">
                        <div>
                            <h3>Actividad 2.1: Traslación</h3>
                            <p>Implementación de transformaciones geométricas (traslación, rotación y escala) manipulando la matriz con push() y pop().</p>
                        </div>
                        <a href="https://editor.p5js.org/MEDINA_ARTURO0610/full/gBdV4-ubS" target="_blank" class="btn-enlace">Ver Proyecto</a>
                    </div>

                    <div class="tarjeta-actividad">
                        <div>
                            <h3>Actividad 2.2: Mini-Proyecto</h3>
                            <p>Videojuego en 2D aplicando Programación Orientada a Objetos (POO), vectores físicos y detección de colisiones.</p>
                        </div>
                        <a href="#" target="_blank" class="btn-enlace">Jugar Ahora</a>
                    </div>

                </div>
            </section>

        </main>

    </div>

</body>
</html>

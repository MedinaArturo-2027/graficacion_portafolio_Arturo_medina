import * as THREE from 'three';

//  Renderizador
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(
  75, 
  window.innerWidth / window.innerHeight, 
  0.1, 
  1000
);
const renderer = new THREE.WebGLRenderer({ antialias: true });

renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

// Limpiar márgenes
document.body.style.margin = '0';
document.body.style.overflow = 'hidden';

//Luces
const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
scene.add(ambientLight);

const directionalLight = new THREE.DirectionalLight(0xffffff, 1);
directionalLight.position.set(5, 5, 5);
scene.add(directionalLight);

// semaforo
const semaforoGroup = new THREE.Group();

// Caja del semáforo
const cajaGeo = new THREE.BoxGeometry(1.2, 4, 1.2);
const cajaMat = new THREE.MeshStandardMaterial({ color: 0x333333 });
const caja = new THREE.Mesh(cajaGeo, cajaMat);
semaforoGroup.add(caja);

// Esferas del semáforo
const esferaGeo = new THREE.SphereGeometry(0.4, 32, 32);

const esferaRoja = new THREE.Mesh(
  esferaGeo, 
  new THREE.MeshStandardMaterial({ color: 0xff0000 })
);
esferaRoja.position.set(0, 1.2, 0.6);

const esferaAmarilla = new THREE.Mesh(
  esferaGeo, 
  new THREE.MeshStandardMaterial({ color: 0xffff00 })
);
esferaAmarilla.position.set(0, 0, 0.6);

const esferaVerde = new THREE.Mesh(
  esferaGeo, 
  new THREE.MeshStandardMaterial({ color: 0x00ff00 })
);
esferaVerde.position.set(0, -1.2, 0.6);

semaforoGroup.add(esferaRoja, esferaAmarilla, esferaVerde);
semaforoGroup.position.x = -2.2;
scene.add(semaforoGroup);

//corazon
const corazonGroup = new THREE.Group();
const cuboGeo = new THREE.BoxGeometry(0.8, 0.8, 0.8);
const cuboMat = new THREE.MeshStandardMaterial({ 
  color: 0xff0055, 
  wireframe: true 
});

// Posiciones para formar la V del corazon
const posicionesCubos = [
  [0, -0.8, 0],       // Punta inferior central
  [-0.8, 0, 0],       // Centro izquierda
  [0.8, 0, 0],        // Centro derecha
  [-1.2, 0.8, 0],     // Pico superior izquierdo
  [1.2, 0.8, 0],      // Pico superior derecho
  [0, 0, 0]           // Centro medio
];

posicionesCubos.forEach(([x, y, z]) => {
  const cubo = new THREE.Mesh(cuboGeo, cuboMat);
  cubo.position.set(x, y, z);
  corazonGroup.add(cubo);
});

// Rotación ligera 
corazonGroup.rotation.z = Math.PI / 4; 
corazonGroup.position.x = 2.2;
scene.add(corazonGroup);

// Posición de la Cámara
camera.position.z = 6;

// Bucle de Animación
function animate() {
  requestAnimationFrame(animate);

  // Rotaciones
  semaforoGroup.rotation.y += 0.01;
  corazonGroup.rotation.y += 0.015;

  // Efecto de palpitación en el corazón usando Math.sin()
  let escala = 1 + Math.sin(Date.now() * 0.003) * 0.25;
  corazonGroup.scale.set(escala, escala, escala);

  renderer.render(scene, camera);
}

// Adaptación de ventana
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

animate();
